<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.predar.predar.controller.DashboardController"
            style="-fx-background-color: #0d1117;"
            prefWidth="1100" prefHeight="700">

    <!-- PANEL IZQUIERDO - Navegación -->
    <left>
        <VBox spacing="10" style="-fx-background-color: #161b22; -fx-padding: 20;">
            <Label text="⛏ PREDAR" style="-fx-text-fill: #58a6ff; -fx-font-size: 18; -fx-font-weight: bold;"/>
            <Label text="Seguridad Minera" style="-fx-text-fill: #8b949e; -fx-font-size: 11;"/>
            <Separator style="-fx-background-color: #30363d;"/>
            <Button text="📊  Dashboard" prefWidth="160"
                    style="-fx-background-color: #1f6feb; -fx-text-fill: white; -fx-background-radius: 6;"/>
            <Button text="🗺  Mapa LiDAR" prefWidth="160"
                    onAction="#handleLidarView"
                    style="-fx-background-color: #21262d; -fx-text-fill: #8b949e; -fx-background-radius: 6;"/>
            <Button text="📁  Archivos" prefWidth="160"
                    style="-fx-background-color: #21262d; -fx-text-fill: #8b949e; -fx-background-radius: 6;"/>
            <Button text="⚙  Configuración" prefWidth="160"
                    style="-fx-background-color: #21262d; -fx-text-fill: #8b949e; -fx-background-radius: 6;"/>
        </VBox>
    </left>

    <!-- PANEL CENTRAL - Monitoreo -->
    <center>
        <VBox spacing="15" style="-fx-padding: 20;">

            <!-- Título -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Monitor en Tiempo Real"
                       style="-fx-text-fill: #e6edf3; -fx-font-size: 20; -fx-font-weight: bold;"/>
                <Label text="● EN VIVO"
                       style="-fx-text-fill: #3fb950; -fx-font-size: 11;"/>
            </HBox>

            <!-- Área LiDAR reservada -->
            <VBox prefHeight="280" style="-fx-background-color: #161b22;
                                          -fx-border-color: #30363d;
                                          -fx-border-radius: 8;
                                          -fx-background-radius: 8;
                                          -fx-alignment: center;">
                <Label text="🗺" style="-fx-font-size: 40;"/>
                <Label text="Visualización LiDAR 3D"
                       style="-fx-text-fill: #8b949e; -fx-font-size: 16; -fx-font-weight: bold;"/>
                <Label text="Módulo disponible en próxima versión"
                       style="-fx-text-fill: #484f58; -fx-font-size: 12;"/>
            </VBox>

            <!-- Tarjetas de gases -->
            <HBox spacing="15">

                <HBox fx:id="methaneCard" spacing="12" prefWidth="200" prefHeight="90"
                      style="-fx-background-color: #161b22; -fx-background-radius: 8;
                             -fx-border-color: #30363d; -fx-border-radius: 8; -fx-padding: 15;">
                    <VBox spacing="4">
                        <Label text="Metano CH₄"
                               style="-fx-text-fill: #8b949e; -fx-font-size: 11;"/>
                        <Label fx:id="methaneValue" text="0.00%"
                               style="-fx-text-fill: #e6edf3; -fx-font-size: 22; -fx-font-weight: bold;"/>
                        <Label text="Límite: 1.0%"
                               style="-fx-text-fill: #484f58; -fx-font-size: 10;"/>
                    </VBox>
                </HBox>

                <HBox fx:id="coCard" spacing="12" prefWidth="200" prefHeight="90"
                      style="-fx-background-color: #161b22; -fx-background-radius: 8;
                             -fx-border-color: #30363d; -fx-border-radius: 8; -fx-padding: 15;">
                    <VBox spacing="4">
                        <Label text="Monóxido CO"
                               style="-fx-text-fill: #8b949e; -fx-font-size: 11;"/>
                        <Label fx:id="coValue" text="0 ppm"
                               style="-fx-text-fill: #e6edf3; -fx-font-size: 22; -fx-font-weight: bold;"/>
                        <Label text="Límite: 25 ppm"
                               style="-fx-text-fill: #484f58; -fx-font-size: 10;"/>
                    </VBox>
                </HBox>

                <HBox fx:id="oxygenCard" spacing="12" prefWidth="200" prefHeight="90"
                      style="-fx-background-color: #161b22; -fx-background-radius: 8;
                             -fx-border-color: #30363d; -fx-border-radius: 8; -fx-padding: 15;">
                    <VBox spacing="4">
                        <Label text="Oxígeno O₂"
                               style="-fx-text-fill: #8b949e; -fx-font-size: 11;"/>
                        <Label fx:id="oxygenValue" text="0.0%"
                               style="-fx-text-fill: #e6edf3; -fx-font-size: 22; -fx-font-weight: bold;"/>
                        <Label text="Mínimo: 19.5%"
                               style="-fx-text-fill: #484f58; -fx-font-size: 10;"/>
                    </VBox>
                </HBox>

            </HBox>
        </VBox>
    </center>

    <!-- PANEL DERECHO - Estado y alertas -->
    <right>
        <VBox spacing="12" prefWidth="220"
              style="-fx-background-color: #161b22; -fx-padding: 20;">

            <Label text="Estado del Sistema"
                   style="-fx-text-fill: #e6edf3; -fx-font-weight: bold; -fx-font-size: 13;"/>
            <Separator style="-fx-background-color: #30363d;"/>

            <!-- Dot + estado -->
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Circle fx:id="statusDot" radius="6" styleClass="dot-normal"/>
                <Label fx:id="systemStatus" text="Sistema: OPERATIVO"
                       styleClass="alert-normal" style="-fx-font-size: 12;"/>
            </HBox>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="📶" style="-fx-font-size: 12;"/>
                <Label fx:id="signalLabel" text="Señal: Fuerte"
                       style="-fx-text-fill: #3fb950; -fx-font-size: 12;"/>
            </HBox>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="🔋" style="-fx-font-size: 12;"/>
                <Label fx:id="batteryLabel" text="Batería: 87%"
                       style="-fx-text-fill: #3fb950; -fx-font-size: 12;"/>
            </HBox>

            <Separator style="-fx-background-color: #30363d;"/>
            <Label text="Alertas Activas"
                   style="-fx-text-fill: #e6edf3; -fx-font-weight: bold; -fx-font-size: 13;"/>

            <VBox fx:id="alertsPanel" spacing="8">
                <Label fx:id="methaneAlert" text="CH₄: NORMAL"
                       styleClass="alert-normal" style="-fx-font-size: 12;"/>
                <Label fx:id="coAlert" text="CO: NORMAL"
                       styleClass="alert-normal" style="-fx-font-size: 12;"/>
                <Label fx:id="oxygenAlert" text="O₂: NORMAL"
                       styleClass="alert-normal" style="-fx-font-size: 12;"/>
            </VBox>

        </VBox>
    </right>

</BorderPane>